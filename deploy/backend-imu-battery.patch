diff --git a/poc/control.c b/poc/control.c
index 368b7a5..6a6cd43 100644
--- a/poc/control.c
+++ b/poc/control.c
@@ -63,6 +63,29 @@ static gboolean mouse_input(JsonObject *o,ProState *s) {
     s->mouse_buttons=(uint8_t)v[3];s->mouse_active=v[4]!=0;
     return TRUE;
 }
+/* PiS2CR: optional "imu": 18 signed 16-bit values (3 samples of accel xyz, gyro xyz); absent means neutral. */
+static gboolean imu_input(JsonObject *o,ProState *s) {
+    JsonNode *n=json_object_get_member(o,"imu");
+    if(!n){s->imu_valid=FALSE;return TRUE;}
+    if(!JSON_NODE_HOLDS_ARRAY(n))return FALSE;
+    JsonArray *a=json_node_get_array(n);if(json_array_get_length(a)!=18)return FALSE;
+    int16_t v[18];
+    for(int i=0;i<18;i++) {
+        JsonNode *e=json_array_get_element(a,i);
+        if(!JSON_NODE_HOLDS_VALUE(e) || json_node_get_value_type(e)!=G_TYPE_INT64)return FALSE;
+        gint64 x=json_node_get_int(e);if(x<-32768 || x>32767)return FALSE;v[i]=(int16_t)x;
+    }
+    for(int i=0;i<18;i++)s->imu_samples[i/6][i%6]=v[i];
+    s->imu_valid=TRUE;return TRUE;
+}
+/* PiS2CR: optional "battery": raw battery/connection byte for the 0x30 report. */
+static gboolean battery_input(JsonObject *o,ProState *s) {
+    JsonNode *n=json_object_get_member(o,"battery");
+    if(!n)return TRUE;
+    if(!JSON_NODE_HOLDS_VALUE(n) || json_node_get_value_type(n)!=G_TYPE_INT64)return FALSE;
+    gint64 x=json_node_get_int(n);if(x<0 || x>255)return FALSE;
+    s->battery=(uint8_t)x;s->battery_set=TRUE;return TRUE;
+}
 static char *request(gpointer data,const char *text) {
     ProControl *c=data;
     c->last_request=g_get_monotonic_time();
@@ -74,14 +97,17 @@ static char *request(gpointer data,const char *text) {
     JsonNode *mn=json_object_get_member(o,"method");
     if(!mn || !JSON_NODE_HOLDS_VALUE(mn) || json_node_get_value_type(mn)!=G_TYPE_STRING)return failure("Expected method string");
     const char *method=json_node_get_string(mn);
+    if(!battery_input(o,c->state))return failure("Invalid battery");
     if(!strcmp(method,"input")) {
         int buttons[3],sticks[4];
         if(!numbers(o,"buttons",3,255,buttons) || !numbers(o,"sticks",4,4095,sticks))return failure("Invalid input frame");
         for(int i=0;i<3;i++)c->state->buttons[i]=buttons[i];
         for(int i=0;i<4;i++)c->state->sticks[i]=sticks[i];
         if(!mouse_input(o,c->state))return failure("Invalid mouse input");
+        if(!imu_input(o,c->state))return failure("Invalid imu input");
         *c->release_at=g_get_monotonic_time()+500000;
     } else if(!strcmp(method,"release")) {
+        c->state->imu_valid=FALSE;
         memset(c->state->buttons,0,3);c->state->mouse_buttons=0;c->state->mouse_active=FALSE;
         c->state->mouse_dx=c->state->mouse_dy=c->state->mouse_wheel=0;
         c->state->sticks[0]=2159;c->state->sticks[1]=1916;
