+++ b/poc/protocol.c
@@ -66,7 +66,7 @@ void pro_input(const ProState *s, uint8_t timer, uint8_t out[50]) {
     out[0] = 0xa1;
     out[1] = 0x30;
     out[2] = timer;
-    out[3] = s->type == CONTROLLER_PRO ? 0x80 : 0x9e;
+    out[3] = s->type == CONTROLLER_PRO ? (s->battery_set ? s->battery : 0x80) : 0x9e;
     if (s->type != CONTROLLER_JOYCON_L) out[4] = s->buttons[0];
     out[5] = s->buttons[1] & (s->type == CONTROLLER_JOYCON_L ? 0x29 :
                               s->type == CONTROLLER_JOYCON_R ? 0x16 : 0xff);
@@ -74,7 +74,15 @@ void pro_input(const ProState *s, uint8_t timer, uint8_t out[50]) {
     if (s->type != CONTROLLER_JOYCON_R) pack(out + 7, s->sticks[0], s->sticks[1]);
     if (s->type != CONTROLLER_JOYCON_L) pack(out + 10, s->sticks[2], s->sticks[3]);
     out[13] = 0x80;
-    if (s->imu) for (int i = 0; i < 3; i++) out[19 + 12 * i] = 0x10;
+    if (s->imu) for (int i = 0; i < 3; i++) {
+        if (s->imu_valid) {
+            for (int j = 0; j < 6; j++) {
+                uint16_t v = (uint16_t)s->imu_samples[i][j];
+                out[14 + 12 * i + 2 * j] = (uint8_t)v;
+                out[15 + 12 * i + 2 * j] = (uint8_t)(v >> 8);
+            }
+        } else out[19 + 12 * i] = 0x10;
+    }
 }
 
